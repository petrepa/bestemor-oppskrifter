---
// Shared Pagefind search box. Pagefind indexes the built site (including the
// hidden transcription in each recipe page), so searching a dish or ingredient
// surfaces the matching scans.
const base = import.meta.env.BASE_URL;
---

<div id="search" class="search-container"></div>

<link href={`${base}/pagefind/pagefind-ui.css`} rel="stylesheet" />
<script is:inline define:vars={{ base }}>
  window.addEventListener('DOMContentLoaded', () => {
    const script = document.createElement('script');
    script.src = base + '/pagefind/pagefind-ui.js';
    script.onload = () => {
      new PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: true,
        translations: {
          placeholder: 'Søk i arkivet — t.d. "lefse"...',
          zero_results: 'Fann ingen skann for [SEARCH_TERM]',
        },
      });
    };
    document.head.appendChild(script);
  });
</script>

<style>
  .search-container {
    max-width: 500px;
    margin: 0 auto;
  }
</style>
