---
import fs from 'node:fs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const oppskrifter = await getCollection('oppskrifter');
  return oppskrifter.map((recipe) => ({
    params: { slug: recipe.id },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);
const base = import.meta.env.BASE_URL;
const scanUrl = `${base}/${recipe.data.original_skann.replace(/^\//, '')}`;

// The physical book this scan comes from, if recorded.
const boker = await getCollection('boker');
const kjeldebok = recipe.data.kjelde
  ? boker.find((b) => b.id === recipe.data.kjelde)
  : undefined;

// Downscaled derivatives (generated at ingest): web (~300 KB) for the inline
// view, thumb (~50 KB) for search-result images. The multi-MB original is only
// loaded when the zoom view opens. Existence checked at build time so missing
// derivatives fall back to the original.
const fileName = recipe.data.original_skann.split('/').pop();
const hasWeb = fs.existsSync(`public/skannar/web/${fileName}`);
const hasThumb = fs.existsSync(`public/skannar/thumb/${fileName}`);
const webUrl = hasWeb ? `${base}/skannar/web/${fileName}` : scanUrl;
const thumbUrl = hasThumb ? `${base}/skannar/thumb/${fileName}` : scanUrl;
---

<BaseLayout title={recipe.data.tittel}>
  <article class="recipe-page">
    <header class="recipe-header">
      <a href={`${base}/kategoriar/`} class="breadcrumb-kategori">{recipe.data.kategori}</a>
      <h1>{recipe.data.tittel}</h1>
      {
        kjeldebok && (
          <a href={`${base}/boker/${kjeldebok.id}/`} class="kjelde-link">
            Frå {kjeldebok.data.namn}
          </a>
        )
      }
      <TagList tags={recipe.data.tags} />
    </header>

    <figure class="scan">
      <img
        src={webUrl}
        alt={`Skannet oppskrift: ${recipe.data.tittel}`}
        fetchpriority="high"
        decoding="async"
        class="scan-image"
        data-thumb={thumbUrl}
        data-pagefind-meta="image[data-thumb], image_alt[alt]"
      />
      <figcaption>Trykk på biletet for å sjå det i full storleik</figcaption>
    </figure>

    <details class="transcription">
      <summary>Automatisk avlesing (kan innehalde feil)</summary>
      <div class="transcription-body">
        <Content />
      </div>
    </details>

    <div class="back-link">
      <a href={`${base}/oppskrifter/`}>&larr; Tilbake til alle oppskrifter</a>
    </div>
  </article>

  <div id="lightbox" class="lightbox">
    <button type="button" class="lightbox-close" aria-label="Lukk">&times;</button>
    <!-- Full-resolution original; loading=lazy defers the multi-MB download
         until the lightbox is actually opened (it is display:none until then). -->
    <img src={scanUrl} alt={`Skannet oppskrift: ${recipe.data.tittel}`} loading="lazy" />
  </div>

  <script is:inline>
    (() => {
      const img = document.querySelector('.scan-image');
      const lightbox = document.getElementById('lightbox');
      if (!img || !lightbox) return;
      const open = () => {
        lightbox.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      };
      const close = () => {
        lightbox.classList.remove('is-open');
        document.body.style.overflow = '';
      };
      img.addEventListener('click', open);
      lightbox.addEventListener('click', close);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && lightbox.classList.contains('is-open')) close();
      });
    })();
  </script>
</BaseLayout>

<style>
  .recipe-page {
    max-width: 800px;
    margin: 0 auto;
  }

  .recipe-header {
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .breadcrumb-kategori {
    font-family: var(--font-handwritten);
    font-size: 1.1rem;
    color: var(--color-green);
    display: block;
    margin-bottom: 0.25rem;
  }

  .recipe-header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
    color: var(--color-accent);
  }

  .kjelde-link {
    display: inline-block;
    font-family: var(--font-handwritten);
    font-size: 1.15rem;
    color: var(--color-muted);
    margin-bottom: 0.75rem;
  }

  .kjelde-link:hover {
    color: var(--color-accent);
  }

  .recipe-header :global(.tag-list) {
    justify-content: center;
  }

  .scan {
    margin: 0 0 1.5rem;
    text-align: center;
  }

  .scan-image {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--color-card-border);
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(61, 43, 31, 0.12);
    cursor: zoom-in;
    background: var(--color-card-bg);
  }

  .scan figcaption {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .transcription {
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: 12px;
    padding: 0.5rem 1.25rem;
  }

  .transcription summary {
    cursor: pointer;
    font-family: var(--font-handwritten);
    font-size: 1.15rem;
    color: var(--color-green-hover);
    padding: 0.5rem 0;
  }

  .transcription-body {
    padding-bottom: 1rem;
    color: var(--color-muted);
  }

  .transcription-body :global(h2) {
    font-size: 1.2rem;
    margin: 1rem 0 0.5rem;
    color: var(--color-accent);
  }

  .transcription-body :global(ul),
  .transcription-body :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .back-link {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-card-border);
  }

  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(24, 16, 10, 0.97);
    align-items: center;
    justify-content: center;
    padding: 2rem;
    z-index: 1000;
    cursor: zoom-out;
    overscroll-behavior: contain;
  }

  .lightbox.is-open {
    display: flex;
  }

  .lightbox img {
    max-width: 100%;
    max-height: 100%;
    border-radius: 8px;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5);
  }

  .lightbox-close {
    position: fixed;
    top: 1rem;
    right: 1.25rem;
    width: 2.75rem;
    height: 2.75rem;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    color: white;
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }

  .lightbox-close:hover {
    background: rgba(255, 255, 255, 0.3);
  }
</style>
