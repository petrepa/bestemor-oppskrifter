---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const oppskrifter = await getCollection('oppskrifter');
  return oppskrifter.map((recipe) => ({
    params: { slug: recipe.id },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);
const base = import.meta.env.BASE_URL;
const scanUrl = `${base}/${recipe.data.original_skann.replace(/^\//, '')}`;
---

<BaseLayout title={recipe.data.tittel}>
  <article class="recipe-page">
    <header class="recipe-header">
      <a href={`${base}/kategoriar/`} class="breadcrumb-kategori">{recipe.data.kategori}</a>
      <h1>{recipe.data.tittel}</h1>
      <TagList tags={recipe.data.tags} />
    </header>

    <figure class="scan">
      <img
        src={scanUrl}
        alt={`Skannet oppskrift: ${recipe.data.tittel}`}
        loading="lazy"
        class="scan-image"
        data-pagefind-meta="image[src], image_alt[alt]"
      />
      <figcaption>Trykk på biletet for å sjå det i full storleik</figcaption>
    </figure>

    <details class="transcription">
      <summary>Automatisk avlesing (kan innehalde feil)</summary>
      <div class="transcription-body">
        <Content />
      </div>
    </details>

    <div class="back-link">
      <a href={`${base}/oppskrifter/`}>&larr; Tilbake til alle oppskrifter</a>
    </div>
  </article>

  <div id="lightbox" class="lightbox" hidden>
    <img src={scanUrl} alt={`Skannet oppskrift: ${recipe.data.tittel}`} />
  </div>

  <script is:inline>
    (() => {
      const img = document.querySelector('.scan-image');
      const lightbox = document.getElementById('lightbox');
      if (!img || !lightbox) return;
      const open = () => {
        lightbox.hidden = false;
        document.body.style.overflow = 'hidden';
      };
      const close = () => {
        lightbox.hidden = true;
        document.body.style.overflow = '';
      };
      img.addEventListener('click', open);
      lightbox.addEventListener('click', close);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !lightbox.hidden) close();
      });
    })();
  </script>
</BaseLayout>

<style>
  .recipe-page {
    max-width: 800px;
    margin: 0 auto;
  }

  .recipe-header {
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .breadcrumb-kategori {
    font-family: var(--font-handwritten);
    font-size: 1.1rem;
    color: var(--color-green);
    display: block;
    margin-bottom: 0.25rem;
  }

  .recipe-header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
    color: var(--color-accent);
  }

  .recipe-header :global(.tag-list) {
    justify-content: center;
  }

  .scan {
    margin: 0 0 1.5rem;
    text-align: center;
  }

  .scan-image {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--color-card-border);
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(61, 43, 31, 0.12);
    cursor: zoom-in;
    background: var(--color-card-bg);
  }

  .scan figcaption {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .transcription {
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: 12px;
    padding: 0.5rem 1.25rem;
  }

  .transcription summary {
    cursor: pointer;
    font-family: var(--font-handwritten);
    font-size: 1.15rem;
    color: var(--color-green-hover);
    padding: 0.5rem 0;
  }

  .transcription-body {
    padding-bottom: 1rem;
    color: var(--color-muted);
  }

  .transcription-body :global(h2) {
    font-size: 1.2rem;
    margin: 1rem 0 0.5rem;
    color: var(--color-accent);
  }

  .transcription-body :global(ul),
  .transcription-body :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .back-link {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-card-border);
  }

  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(30, 20, 12, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    z-index: 100;
    cursor: zoom-out;
  }

  .lightbox img {
    max-width: 100%;
    max-height: 100%;
    border-radius: 8px;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5);
  }
</style>
