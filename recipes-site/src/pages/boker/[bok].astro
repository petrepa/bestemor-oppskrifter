---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const boker = await getCollection('boker');
  return boker.map((bok) => ({
    params: { bok: bok.id },
    props: { bok },
  }));
}

const { bok } = Astro.props;
const { Content } = await render(bok);
const base = import.meta.env.BASE_URL;

const oppskrifter = await getCollection(
  'oppskrifter',
  (recipe) => recipe.data.kjelde === bok.id,
);
const sorterte = oppskrifter.sort((a, b) =>
  a.data.tittel.localeCompare(b.data.tittel, 'nn'),
);
---

<BaseLayout title={bok.data.namn}>
  <header class="bok-header">
    <img
      src={`${base}/${bok.data.bilete}`}
      alt={`Omslaget til ${bok.data.namn}`}
      class="bok-cover"
      decoding="async"
    />
    <div class="bok-intro">
      <h1>{bok.data.namn}</h1>
      <p class="count">
        {sorterte.length} {sorterte.length === 1 ? 'oppskrift' : 'oppskrifter'}
      </p>
      <div class="bok-skildring">
        <Content />
      </div>
    </div>
  </header>

  <div class="recipes-grid">
    {
      sorterte.map((recipe) => (
        <RecipeCard
          tittel={recipe.data.tittel}
          slug={recipe.id}
          kategori={recipe.data.kategori}
          tags={recipe.data.tags}
          original_skann={recipe.data.original_skann}
        />
      ))
    }
  </div>

  <div class="back-link">
    <a href={`${base}/boker/`}>&larr; Tilbake til alle bøkene</a>
  </div>
</BaseLayout>

<style>
  .bok-header {
    display: flex;
    gap: 2rem;
    align-items: center;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .bok-cover {
    width: 220px;
    max-width: 100%;
    border-radius: 12px;
    border: 1px solid var(--color-card-border);
    box-shadow: 0 4px 16px rgba(61, 43, 31, 0.12);
  }

  .bok-intro {
    flex: 1;
    min-width: 240px;
  }

  .bok-intro h1 {
    color: var(--color-accent);
    margin-bottom: 0.25rem;
  }

  .count {
    font-family: var(--font-handwritten);
    font-size: 1.3rem;
    color: var(--color-muted);
    margin-bottom: 0.75rem;
  }

  .bok-skildring {
    color: var(--color-muted);
  }

  .recipes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .back-link {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-card-border);
  }
</style>
